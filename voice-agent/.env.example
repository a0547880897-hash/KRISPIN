# ============================================================================
#  Bank Yahav voice sales agent — environment template
#  Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ============================================================================

# --- OpenAI Realtime ---------------------------------------------------------
OPENAI_API_KEY=sk-...
# Realtime model. gpt-realtime-2 = GPT-5-class reasoning voice model (supports
# reasoning effort below). The beta interface + gpt-4o-realtime-preview were
# removed 2026-05-12. Verify the latest alias in OpenAI's docs at deploy time.
OPENAI_REALTIME_MODEL=gpt-realtime-2
# Reasoning intensity for gpt-realtime-2: minimal|low|medium|high|xhigh.
# high = smart & flowing; drop to medium if replies feel slow. (gpt-realtime-2 only)
REASONING_EFFORT=high
# Model used to summarize the transcript at the end of the call (chat endpoint).
OPENAI_SUMMARY_MODEL=gpt-4o-mini
# Voice. Newest, most natural/expressive (Realtime-only): marin, cedar.
# Others: alloy, ash, ballad, coral, echo, sage, shimmer, verse.
AGENT_VOICE=marin

# --- Voice activity detection (turn-taking) ----------------------------------
# Higher threshold = less sensitive: rejects line echo / the agent hearing
# itself (which causes a self-interruption loop). Raise toward 0.9 if it loops;
# lower toward 0.5 if it doesn't hear the caller.
VAD_THRESHOLD=0.8
VAD_SILENCE_MS=800
VAD_PREFIX_MS=300
# Caller speech must persist this long (ms) before it counts as a real
# interruption — filters out line echo of the agent's own voice. Raise toward
# 500 if echo still interrupts; lower toward 200 for snappier barge-in.
BARGE_IN_CONFIRM_MS=350

# --- Server ------------------------------------------------------------------
PORT=3340
# Public host (NO scheme, NO trailing slash) that Twilio reaches the server on.
# The Media Stream URL is built as: wss://<PUBLIC_HOSTNAME>/media-stream
# In dev use an ngrok host, e.g. abcd-1-2-3-4.ngrok-free.app
PUBLIC_HOSTNAME=your-public-domain.example.com
# Optional path prefix when sharing a domain behind a reverse proxy.
# Example: nginx routes "/yahav/" to this app -> set PUBLIC_PATH_PREFIX=/yahav
# Leave EMPTY if the app is served at the domain root. No trailing slash.
PUBLIC_PATH_PREFIX=

# --- Twilio (used only to validate inbound requests, optional) ---------------
TWILIO_AUTH_TOKEN=

# --- Business identity -------------------------------------------------------
BUSINESS_NAME=בנק יהב
# Callback number the agent reads out to the caller at the end of the call.
BUSINESS_PHONE=053-563-5573

# --- Email summary (Gmail) ---------------------------------------------------
# The summary is sent FROM this Gmail account at the end of each call.
# Recommended: a Google App Password (requires 2FA on the account).
# https://myaccount.google.com/apppasswords
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=
# Where the summary is delivered (defaults to GMAIL_USER if empty).
SUMMARY_TO=youraddress@gmail.com
